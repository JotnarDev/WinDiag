# Real WiFi credentials - never commit these. Copy app/wifi-config.example.txt to
# app/wifi-config.txt and fill in your real network info locally.
app/wifi-config.txt

# Build artifacts (regenerated by app/build.bat) - not source, don't track.
app/*.exe
app/Runa-M.ico
*.obj
*.pdb

# Third-party / optional bundled tools - not redistributed in this repo.
# Drop your own copies into app/ locally if you want these integrations; see docs/BUILD.md.
app/BatteryInfoView.exe
app/BatteryInfoView.cfg
app/keytest.exe

# Reports generated by the tool itself (defaults to Desktop\report, but just in case
# someone points it at a folder inside the repo during testing).
report/
*.report.txt
Export-Excel.txt

# Editor/OS cruft
.vs/
.vscode/
*.user
Thumbs.db
.DS_Store

# Leftover debugging scripts from development - not part of the shipped tool.
_check_*.ps1
